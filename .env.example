# Where the dashboard server listens (all interfaces unless HOST is set).
PORT=3000
#HOST=0.0.0.0

# Per-plugin GraphQL endpoints. Unset = the defaults below. Setting
# PLUGIN_<NAME>_URL for a name not in server/src/plugins.ts registers a brand
# new plugin with no code change.
PLUGIN_AUTOCAL_URL=http://localhost:3001/graphql
PLUGIN_NOTES_URL=http://localhost:3002/graphql
PLUGIN_PHILOTES_URL=http://localhost:3003/graphql
PLUGIN_EUNOMIA_URL=http://localhost:4000/graphql

# Server-side tokens, one per plugin (an API key / token minted in that app).
# Anything the browser sends in an `x-<plugin>-token` header wins over these.
#PLUGIN_AUTOCAL_TOKEN=
#PLUGIN_NOTES_TOKEN=cet_...
#PLUGIN_PHILOTES_TOKEN=
#PLUGIN_EUNOMIA_TOKEN=

# Header each app reads its credential from. Default `authorization` (sent as
# `Bearer <token>`); any other header gets the raw credential. eunomia already
# defaults to x-api-key, which is where its non-expiring device keys are
# accepted — set this only to override.
#PLUGIN_EUNOMIA_AUTH_HEADER=x-api-key

# ── Full stack (docker-compose.stack.yml) ────────────────────────────────────
# Only needed to run every app plus the dashboard from this repo:
#   docker compose -f docker-compose.stack.yml up --build
# The four apps then share one Postgres, each with its own role and database.

# Host the published ports actually answer on. `localhost` for a local docker
# daemon; the daemon's hostname when `docker context ls` shows a remote one
# (ports publish there, not here). Apps put this in magic links and CORS.
#PUBLIC_HOST=localhost
#TZ=UTC

# Required — the stack refuses to start without it.
#JWT_SECRET=          # philotes; openssl rand -hex 32
# Only once the eunomia service is uncommented (it has no published image yet).
#BETTER_AUTH_SECRET=  # eunomia;  openssl rand -base64 32

# Image tags. Default `latest`; pin to a release to stop a stack restart from
# silently upgrading an app.
#AUTOCAL_TAG=latest
#PHILOTES_TAG=latest

# An app running outside the stack is reached over the host, not the compose
# network. eunomia has no published image, so it defaults to PUBLIC_HOST:4000.
#PLUGIN_EUNOMIA_URL=http://docker.lan:4000/graphql

# auto-cal, notes and philotes disable GraphQL introspection under
# NODE_ENV=production (Apollo's default), which makes them impossible to
# stitch. The stack leaves NODE_ENV empty for them; set one back to
# `production` to restore its production behaviour, at the cost of that app
# dropping off the dashboard. See the header of docker-compose.stack.yml for
# exactly what each one trades.
#AUTOCAL_NODE_ENV=production
#NOTES_NODE_ENV=production
#PHILOTES_NODE_ENV=production
