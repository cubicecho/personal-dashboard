    "@graphql-tools/wrap": "^10.1.4",
    "express": "^4.21.2",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
