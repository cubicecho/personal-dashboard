{
  "name": "@cubicecho/dashboard-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Stitching gateway + static dashboard host",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@graphql-tools/executor-http": "^2.1.1",
